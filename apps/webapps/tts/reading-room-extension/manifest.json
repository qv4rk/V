{
  "manifest_version": 3,
  "name": "FeistTech Reading Room",
  "version": "0.1.0",
  "description": "Read almost any webpage aloud with one, two, or three alternating narrators.",
  "permissions": ["activeTab", "scripting", "storage"],
  "action": {
    "default_title": "Open Reading Room",
    "default_popup": "popup.html"
  },
  "background": { "service_worker": "background.js" },
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }]
}
